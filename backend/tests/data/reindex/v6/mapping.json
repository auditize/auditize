        }
      }
    },
    "source": {
      "type": "object",
      "dynamic": true
    },
    "source_fields": {
      "type": "keyword"
    },
    "actor": {
      "properties": {
        "ref": {
          "type": "keyword"
        },
        "type": {
          "type": "keyword"
        },
        "name": {
          "type": "text",
          "analyzer": "custom_asciifolding",
          "search_analyzer": "custom_asciifolding",
          "fields": {
            "keyword": {
              "type": "keyword"
            }
          }
        },
        "extra": {
          "type": "object",
          "dynamic": true
        },
        "extra_fields": {
          "type": "keyword"
        }
      }
    },
    "resource": {
      "properties": {
        "ref": {
